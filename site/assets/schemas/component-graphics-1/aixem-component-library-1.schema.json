              "unit": {
                "type": "string"
              },
              "values": {
                "type": "array"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "displayName",
        "ports",
        "properties",
        "presentations"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "minLength": 1,
          "type": "string"
        },
        "created": {
          "format": "date",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "origin": {
          "minLength": 1,
          "type": "string"
        },
        "sourceDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "sourceUri": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "license",
        "author",
        "created"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.aixem.org/component-graphics/aixlib/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": "1.0"
    },
    "library": {
      "additionalProperties": false,
      "properties": {
