              "metadata": {
                "type": "object"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "terminal": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "input",
                  "output",
                  "bidirectional",
                  "passive",
                  "power-input",
                  "power-output",
                  "open-collector",
                  "open-emitter",
                  "tri-state",
                  "no-connect",
                  "unspecified",
                  "architectural-control",
                  "architectural-load",
                  "architectural-source",
                  "generic"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "type"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "type": "array"
