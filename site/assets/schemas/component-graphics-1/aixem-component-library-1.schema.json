          "minItems": 1,
          "type": "array"
        },
        "dependencies": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "path": {
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9._/-]*$",
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "path",
              "digest"
            ],
            "type": "object"
          },
          "maxItems": 1024,
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "namespace": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "components",
        "provenance"
      ],
      "type": "object"
    },
    "schema": {
      "const": "https://schemas.aixem.org/component-graphics/aixlib/1"
    }
  },
  "required": [
    "schema",
    "formatVersion",
    "library"
  ],
  "title": "AIXEM Component Library 1.0 Candidate",
  "type": "object"
}
