              },
              "metadata": {
                "type": "object"
              },
              "parameterMap": {
                "additionalProperties": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              },
              "portMap": {
                "additionalProperties": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              },
              "purpose": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "purpose",
              "asset",
              "portMap"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "properties": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "default": {},
              "description": {
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "quantity",
                  "enum",
                  "uri"
