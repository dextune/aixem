          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "models": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "path": {
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9._/-]*$",
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "path",
              "digest",
              "mediaType"
