aixem 1.0
model h015-local-net-project-net-equivalence-collision:bridge title="Bridge"
feature component.graphics@1 required=true
feature explicit.layout@2 required=true
feature hierarchical.interface@1 required=true

port VCC direction=input role=power label=VCC
port AUX direction=passive role=power label=AUX

component U1 type=authoring:controller-12 refdes=U1 value=AXC12

net shared_1 = U1.9 @VCC @AUX
noconn U1.1
noconn U1.2
noconn U1.3
noconn U1.4
noconn U1.5
noconn U1.6
noconn U1.7
noconn U1.8
noconn U1.11
noconn U1.12
