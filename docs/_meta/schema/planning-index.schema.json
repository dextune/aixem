{
  "$id": "https://schemas.aixem.org/documentation/planning-index/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIXEM release planning index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "formatVersion",
    "plans"
  ],
  "properties": {
    "schema": {
      "const": "https://schemas.aixem.org/documentation/planning-index/1"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "title",
          "path",
          "status"
        ],
        "properties": {
          "version": {
            "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){1,2}$",
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "path": {
            "pattern": "^planning/releases/[0-9]+\\.[0-9]+(?:\\.[0-9]+){1,2}/[a-z0-9-]+\\.md$",
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "active",
              "completed",
              "superseded",
              "abandoned"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
