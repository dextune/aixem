{
  "$defs": {
    "fileRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "path": {
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9._/-]*$",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest",
        "mediaType"
      ],
      "type": "object"
    },
    "projectNet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/projectNetMember"
          },
          "maxItems": 100000,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "metadata": {
          "type": "object"
        },
        "role": {
          "enum": [
            "signal",
            "power",
            "clock",
            "reset",
            "control",
            "analog"
          ]
        }
      },
      "required": [
        "id",
        "members"
      ],
      "type": "object"
    },
    "projectNetMember": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "sheet": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "port"
      ],
      "type": "object"
    },
    "renderPolicy": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "svg",
            "canvas2d",
            "pdf",
            "custom"
          ]
        },
        "defaultVariantPolicy": {
          "enum": [
            "asset-default",
            "library-default",
            "explicit-only"
          ]
        },
        "fontPolicy": {
          "enum": [
            "bundled-metrics",
            "system-fallback",
            "declared-fixture"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "remoteAssets": {
          "enum": [
            "deny",
            "allow-listed"
          ]
        },
        "unsupportedRequiredFeature": {
          "enum": [
            "reject",
            "diagnostic-only"
          ]
        }
      },
      "required": [
        "purpose",
        "backend",
        "fontPolicy",
        "remoteAssets"
      ],
      "type": "object"
    },
    "sheet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/fileRef"
        },
        "metadata": {
          "type": "object"
        },
        "order": {
          "type": "integer"
        },
        "parent": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/fileRef"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "source",
        "layout"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.aixem.org/component-graphics/aixproj/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": "2.0"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "applicationProfile": {
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "features": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        },
        "libraries": {
          "items": {
            "$ref": "#/$defs/fileRef"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array"
        },
        "metadata": {
          "type": "object"
        },
        "outputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              },
              "path": {
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9._/-]*$",
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "path",
              "mediaType"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "projectNets": {
          "items": {
            "$ref": "#/$defs/projectNet"
          },
          "maxItems": 100000,
          "type": "array"
        },
        "provenance": {
          "type": "object"
        },
        "renderPolicy": {
          "$ref": "#/$defs/renderPolicy"
        },
        "sheets": {
          "items": {
            "$ref": "#/$defs/sheet"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array"
        },
        "status": {
          "enum": [
            "example",
            "draft",
            "controlled",
            "released"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "applicationProfile",
        "sheets",
        "projectNets",
        "libraries",
        "renderPolicy"
      ],
      "type": "object"
    },
    "schema": {
      "const": "https://schemas.aixem.org/component-graphics/aixproj/2"
    }
  },
  "required": [
    "schema",
    "formatVersion",
    "project"
  ],
  "title": "AIXEM Multi-Sheet Project Manifest 2.0 Candidate",
  "type": "object"
}
