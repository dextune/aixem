{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.aixem.org/agent/live-run/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "type": "string"
    },
    "authoringRunRecord": {
      "additionalProperties": true,
      "type": "object"
    },
    "authority": {
      "const": "derived-live-evidence-only"
    },
    "caseId": {
      "type": "string"
    },
    "claimEligible": {
      "type": "boolean"
    },
    "corpus": {
      "additionalProperties": false,
      "properties": {
        "baselineRelease": {
          "minLength": 3,
          "type": "string"
        },
        "id": {
          "minLength": 3,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "baselineRelease"
      ],
      "type": "object"
    },
    "evaluation": {
      "additionalProperties": true,
      "type": "object"
    },
    "evidenceDigest": {
      "$ref": "#/$defs/digest"
    },
    "execution": {
      "additionalProperties": true,
      "type": "object"
    },
    "executor": {
      "additionalProperties": true,
      "type": "object"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "liveExternalAgentExecuted": {
      "type": "boolean"
    },
    "observation": {
      "additionalProperties": true,
      "type": "object"
    },
    "observationConsistency": {
      "additionalProperties": true,
      "properties": {
        "authority": {
          "const": "change-set"
        },
        "consistent": {
          "type": "boolean"
        }
      },
      "required": [
        "consistent",
        "authority"
      ],
      "type": "object"
    },
    "protocolVersion": {
      "minLength": 1,
      "type": "string"
    },
    "release": {
      "minLength": 3,
      "type": "string"
    },
    "repositoryRelease": {
      "minLength": 3,
      "type": "string"
    },
    "retentionRequired": {
      "const": true
    },
    "schema": {
      "const": "https://schemas.aixem.org/agent/live-run/1"
    },
    "secretHygiene": {
      "additionalProperties": true,
      "properties": {
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "type": "object"
    },
    "stage": {
      "additionalProperties": true,
      "type": "object"
    },
    "stageIntegrity": {
      "additionalProperties": true,
      "properties": {
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "type": "object"
    },
    "stageValidation": {
      "additionalProperties": true,
      "type": "object"
    },
    "task": {
      "additionalProperties": true,
      "type": "object"
    },
    "terminalStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "TIMEOUT",
        "EXECUTOR_ERROR",
        "INVALID_STAGE"
      ]
    }
  },
  "required": [
    "schema",
    "formatVersion",
    "release",
    "generatedAt",
    "caseId",
    "attemptId",
    "terminalStatus",
    "task",
    "stage",
    "executor",
    "execution",
    "observation",
    "authoringRunRecord",
    "evaluation",
    "stageValidation",
    "liveExternalAgentExecuted",
    "claimEligible",
    "retentionRequired",
    "authority",
    "evidenceDigest",
    "repositoryRelease",
    "corpus",
    "protocolVersion",
    "stageIntegrity",
    "observationConsistency",
    "secretHygiene"
  ],
  "title": "AIXEM Live Run Evidence 1",
  "type": "object"
}
