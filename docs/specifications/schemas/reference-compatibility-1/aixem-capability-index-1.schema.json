{
  "$id": "https://schemas.aixem.org/reference/aixcap/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilityIndex": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cards": {
                "items": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "id": {
                "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
                "type": "string"
              },
              "implementations": {
                "items": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "routes": {
                "items": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "schemas": {
                "items": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "summary": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "validators": {
                "items": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "title",
              "cards",
              "implementations",
              "validators"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "capabilities"
      ],
      "type": "object"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "schema": {
      "const": "https://schemas.aixem.org/reference/aixcap/1"
    }
  },
  "required": [
    "schema",
    "formatVersion",
    "capabilityIndex"
  ],
  "title": "AIXEM Capability Index 1.0",
  "type": "object"
}
