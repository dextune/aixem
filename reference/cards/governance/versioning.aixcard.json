    "rules": [
      {
        "id": "AIXEM-REQ-GOV-0001",
        "level": "must",
        "text": "**MUST.** A published release MUST have one explicit numeric release version using two to four dot-separated components and one immutable release identifier."
      },
      {
        "id": "AIXEM-REQ-GOV-0002",
        "level": "must",
        "text": "**MUST.** Moving or renaming a published canonical document MUST NOT change its stable document ID."
      },
      {
        "id": "AIXEM-REQ-GOV-0003",
        "level": "must",
        "text": "**MUST.** An incompatible serialized-format change MUST increment the declared format or schema version and provide migration guidance."
      }
    ],
