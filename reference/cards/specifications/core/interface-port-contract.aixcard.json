    "rules": [
      {
        "id": "AIXEM-REQ-HIER-0001",
        "level": "must",
        "text": "**MUST.** A semantic source that declares interface ports or uses @PORT endpoints MUST declare hierarchical.interface@1 as a required feature."
      },
      {
        "id": "AIXEM-REQ-HIER-0002",
        "level": "must",
        "text": "**MUST.** Every @PORT token in a net or no-connect statement MUST resolve to one unique top-level port declaration in the same leaf semantic source."
      },
      {
        "id": "AIXEM-REQ-HIER-0003",
        "level": "must",
        "text": "**MUST.** An interface port MUST occur in at most one local semantic net and MUST NOT be both net-connected and explicitly no-connect."
      }
